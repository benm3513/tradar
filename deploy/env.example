# Tradar runtime
TRADAR_ENV=local
TRADAR_PROFILE=paper
TRADAR_CONFIG=config/tradar.yaml
TRADAR_DB_PATH=./data/tradarbot.db
TRADAR_DATA_DIR=./data
TRADAR_ARTIFACT_DIR=./artifacts/models/v50_sig_importance
TRADAR_CONFIRM_LIVE=false

# Execution provider. Keep paper/dry-run unless intentionally cutting over.
EXECUTION_PROVIDER=alpaca
EXECUTION_MODE=paper

# Alpaca paper credentials. Required only when using live/dry_run_live broker paths
# that call Alpaca APIs.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Binance credentials if used.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Safety: real live profile must explicitly set this to true.
TRADAR_CONFIRM_LIVE=false

# Never commit a real .env or /etc/tradar/tradar.env with secrets.
